{
  "read_file": {
    "enabled": true,
    "description": "Use absolute paths for files.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    }
  },
  "read_multiple_files": {
    "enabled": true,
    "description": "Use absolute paths for files.",
    "inputSchema": {
      "type": "object",
      "properties": { "paths": { "type": "array", "items": { "type": "string" } } },
      "required": ["paths"]
    }
  },
  "write_file": {
    "enabled": true,
    "description": "Use absolute paths for files. This operation occurs outside of Cursor's sandbox.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" }, "content": { "type": "string" } },
      "required": ["path", "content"]
    }
  },
  "edit_file": {
    "enabled": true,
    "description": "Use absolute paths for files. This operation occurs outside of Cursor's sandbox.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oldText": { "type": "string" },
              "newText": { "type": "string" }
            },
            "required": ["oldText", "newText"]
          }
        },
        "dryRun": { "type": "boolean", "default": false }
      },
      "required": ["path", "edits"]
    }
  },
  "create_directory": {
    "enabled": true,
    "description": "Use absolute paths for files. This operation occurs outside of Cursor's sandbox.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    }
  },
  "list_directory": {
    "enabled": true,
    "description": "Use absolute paths for files.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    }
  },
  "directory_tree": {
    "enabled": true,
    "description": "Use absolute paths for files. Call directory_tree on your workspace root instead of verifying the existence of individual files and directories.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    }
  },
  "move_file": {
    "enabled": true,
    "description": "Use absolute paths for files. This operation occurs outside of Cursor's sandbox.",
    "inputSchema": {
      "type": "object",
      "properties": { "source": { "type": "string" }, "destination": { "type": "string" } },
      "required": ["source", "destination"]
    }
  },
  "search_files": {
    "enabled": true,
    "description": "Use absolute paths for files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "pattern": { "type": "string" },
        "excludePatterns": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "required": ["path", "pattern"]
    }
  },
  "get_file_info": {
    "enabled": true,
    "description": "Use absolute paths for files.",
    "inputSchema": {
      "type": "object",
      "properties": { "path": { "type": "string" } },
      "required": ["path"]
    }
  },
  "list_allowed_directories": {
    "enabled": true,
    "description": "List all allowed directories.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  }
}
